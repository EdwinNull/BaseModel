{
  "roots": [
    "docs",
    "PPT",
    "research",
    "plans"
  ],
  "exclude": [
    ".*",
    "~$*",
    "__pycache__",
    "node_modules",
    "*.pyc",
    "Thumbs.db",
    "desktop.ini"
  ],
  "assistant": {
    "provider": "openai",
    "providers": [
      {
        "id": "openai",
        "name": "OpenAI",
        "base_url": "https://api.openai.com/v1",
        "model": ""
      }
    ],
    "web_search": "responses:openai",
    "exclude": [
      "docs/汇报/课题申报/*任务书*",
      "docs/会议记录/*会议记录*"
    ]
  }
}
